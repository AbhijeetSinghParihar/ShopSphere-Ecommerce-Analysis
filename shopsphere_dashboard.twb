    <worksheet name='KPI'>
      <table>
        <view>
          <datasources>
            <datasource caption='shopsphere_orders' name='federated.1gtzsag1ka75q415ttkdo1e7j2h4' />
          </datasources>
          <datasource-dependencies datasource='federated.1gtzsag1ka75q415ttkdo1e7j2h4'>
            <column caption='Profit Margin' datatype='real' name='[Calculation_0067396618768384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
